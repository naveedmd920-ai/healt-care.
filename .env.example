# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"
CORS_ORIGIN="*"

# Authentication & Security
JWT_SECRET="rural-health-connect-dev-jwt-secret-change-in-prod"
JWT_EXPIRES_IN="7d"

# Database Configuration
# Set DB_CLIENT="mysql" to connect to a MySQL 8.0+ server.
# When omitted or set to "sqlite", the app uses the embedded SQLite relational DB at ./database/rural_health_connect.db
DB_CLIENT="sqlite"
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="rural_health_connect"

# Payment Gateway Configuration (Optional - uses Development Payment Simulation when omitted)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Optional Gemini API Key (server-side only, if used)
GEMINI_API_KEY=""
